{
  "expo": {
    "name": "AI Weather",
    "slug": "ai-weather",
    "version": "1.0.1",
    "scheme": "aiweather",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.myweatherai.app",
      "appleTeamId": "WZ43D29S4L",
      "buildNumber": "5",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.myweatherai.app"]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.myweatherai.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#fef5ea",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.ACCESS_COARSE_LOCATION"],
      "blockedPermissions": ["android.permission.ACCESS_FINE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@bacons/apple-targets",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AI Weather uses your approximate location to show local weather conditions."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fef5ea",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b875e93d-f34b-4ebd-b76a-6be343e3bfe7"
      }
    },
    "owner": "jmadrazo7",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/b875e93d-f34b-4ebd-b76a-6be343e3bfe7",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
